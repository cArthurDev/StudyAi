# Environment Configuration for StudyMind AI

# Backend Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/studymind_db
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/studymind_db

# Security
SECRET_KEY=change_this_to_a_secure_random_key_in_production_2026

# Ollama Local AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# File Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
